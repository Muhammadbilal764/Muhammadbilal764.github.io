<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TRIMS. – Sharp Cuts. Sharper Standards.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500&family=Bebas+Neue&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --gold: #C9952A;
    --gold-light: #E8B84B;
    --cream: #F5EFE0;
    --dark: #0E0D0B;
    --dark2: #1A1915;
    --dark3: #252420;
    --muted: #7A7568;
    --text: #E8E4DA;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--dark);
    color: var(--text);
    overflow-x: hidden;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.25rem 4rem;
    background: rgba(14,13,11,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(201,149,42,0.15);
    transition: padding 0.3s;
  }

  .logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.8rem;
    letter-spacing: 0.12em;
    color: var(--cream);
    display: flex; align-items: center; gap: 0.5rem;
  }
  .logo-scissors { color: var(--gold); font-size: 1.3rem; }

  .nav-links {
    display: flex; align-items: center; gap: 2.5rem;
    list-style: none;
  }
  .nav-links a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--cream); }

  .nav-book {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.65rem 1.4rem;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .nav-book:hover { background: var(--gold); color: var(--dark); }

  /* ── HERO ── */
  #home {
    min-height: 100vh;
    display: flex; align-items: flex-end;
    position: relative;
    overflow: hidden;
    padding-bottom: 5rem;
  }

  .hero-bg {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(14,13,11,0.3) 0%, rgba(14,13,11,0.7) 60%, var(--dark) 100%),
                url('https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=1600&q=80') center/cover no-repeat;
  }

  .hero-badge {
    position: absolute; top: 8rem; left: 4rem;
    display: flex; align-items: center; gap: 0.5rem;
    background: rgba(14,13,11,0.7);
    border: 1px solid rgba(201,149,42,0.4);
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    font-size: 0.8rem;
    color: var(--cream);
    backdrop-filter: blur(8px);
  }
  .hero-badge .star { color: var(--gold); }

  .hero-content {
    position: relative; z-index: 2;
    padding: 0 4rem;
    max-width: 900px;
  }

  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 900;
    line-height: 1.0;
    color: var(--cream);
    margin-bottom: 1.5rem;
  }
  .hero-title em {
    font-style: italic;
    color: var(--gold);
  }

  .hero-sub {
    font-size: 1rem;
    color: var(--muted);
    font-weight: 300;
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 2.5rem;
  }

  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  .btn-primary {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 1rem 2rem;
    background: var(--gold);
    color: var(--dark);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  .btn-primary:hover { background: var(--gold-light); transform: translateY(-1px); }

  .btn-outline {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 1rem 2rem;
    border: 1px solid rgba(232,228,218,0.3);
    color: var(--cream);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .btn-outline:hover { border-color: var(--cream); background: rgba(232,228,218,0.06); }

  /* ── SECTION COMMONS ── */
  section { padding: 6rem 4rem; }
  .section-label {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--cream);
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }
  .divider {
    width: 48px; height: 2px;
    background: var(--gold);
    margin-bottom: 2.5rem;
  }

  /* ── SERVICES ── */
  #services { background: var(--dark2); }

  .services-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3rem; flex-wrap: wrap; gap: 1.5rem; }
  .services-header p { color: var(--muted); max-width: 380px; line-height: 1.7; font-size: 0.9rem; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    background: rgba(201,149,42,0.12);
    border: 1px solid rgba(201,149,42,0.12);
  }

  .service-card {
    background: var(--dark2);
    padding: 2rem;
    transition: background 0.2s;
    cursor: default;
  }
  .service-card:hover { background: var(--dark3); }

  .service-icon {
    font-size: 1.6rem;
    margin-bottom: 1rem;
    display: block;
  }
  .service-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    color: var(--cream);
    margin-bottom: 0.4rem;
  }
  .service-desc { font-size: 0.82rem; color: var(--muted); line-height: 1.6; margin-bottom: 1.2rem; }
  .service-price {
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--gold);
    font-family: 'Playfair Display', serif;
  }
  .service-price span { font-size: 0.75rem; color: var(--muted); font-family: 'DM Sans', sans-serif; }

  /* ── ABOUT ── */
  #about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .about-image-wrap {
    position: relative;
    aspect-ratio: 4/5;
  }
  .about-image-wrap img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .about-accent {
    position: absolute;
    bottom: -1.5rem; right: -1.5rem;
    width: 60%; height: 60%;
    border: 1px solid var(--gold);
    z-index: -1;
  }
  .about-badge {
    position: absolute; top: 1.5rem; left: -1.5rem;
    background: var(--gold);
    color: var(--dark);
    padding: 1rem 1.25rem;
    text-align: center;
  }
  .about-badge .num {
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1;
    display: block;
  }
  .about-badge .lbl { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; }

  .about-text p {
    color: var(--muted);
    line-height: 1.8;
    font-size: 0.92rem;
    margin-bottom: 1rem;
  }

  .about-stats {
    display: flex; gap: 2.5rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(201,149,42,0.2);
  }
  .stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: var(--gold);
    display: block;
  }
  .stat-lbl { font-size: 0.78rem; color: var(--muted); letter-spacing: 0.08em; }

  /* ── REVIEWS ── */
  #reviews { background: var(--dark2); }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .review-card {
    background: var(--dark3);
    border: 1px solid rgba(201,149,42,0.12);
    padding: 1.8rem;
    transition: border-color 0.2s;
  }
  .review-card:hover { border-color: rgba(201,149,42,0.35); }

  .review-stars { color: var(--gold); font-size: 0.9rem; margin-bottom: 1rem; letter-spacing: 0.1em; }
  .review-text { font-size: 0.88rem; color: var(--muted); line-height: 1.7; margin-bottom: 1.5rem; font-style: italic; }
  .review-author { display: flex; align-items: center; gap: 0.75rem; }
  .review-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--gold);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.78rem; font-weight: 500; color: var(--dark);
  }
  .review-name { font-size: 0.85rem; color: var(--cream); font-weight: 500; }
  .review-meta { font-size: 0.75rem; color: var(--muted); }

  .reviews-summary {
    display: flex; align-items: center; gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .rating-big {
    font-family: 'Playfair Display', serif;
    font-size: 4rem;
    color: var(--cream);
    line-height: 1;
  }
  .rating-info { display: flex; flex-direction: column; gap: 0.3rem; }
  .rating-stars { color: var(--gold); font-size: 1.1rem; letter-spacing: 0.1em; }
  .rating-count { font-size: 0.8rem; color: var(--muted); }

  /* ── VISIT / MAP ── */
  #visit {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
    background: var(--dark);
  }

  .visit-info { }
  .visit-detail {
    display: flex; gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(201,149,42,0.1);
  }
  .visit-detail:last-of-type { border-bottom: none; }
  .visit-icon { color: var(--gold); font-size: 1.1rem; margin-top: 0.1rem; flex-shrink: 0; }
  .visit-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); margin-bottom: 0.25rem; }
  .visit-value { font-size: 0.92rem; color: var(--cream); line-height: 1.5; }

  .map-placeholder {
    background: var(--dark2);
    border: 1px solid rgba(201,149,42,0.15);
    height: 360px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .map-placeholder .map-pin { font-size: 2.5rem; }

  /* ── BOOKING CTA ── */
  #booking {
    text-align: center;
    background: var(--dark2);
    padding: 5rem 4rem;
    position: relative;
    overflow: hidden;
  }
  #booking::before {
    content: 'TRIMS';
    position: absolute;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 20vw;
    color: rgba(201,149,42,0.03);
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    pointer-events: none;
  }
  #booking .section-title { margin-bottom: 1rem; }
  #booking p { color: var(--muted); margin-bottom: 2.5rem; font-size: 0.92rem; }

  /* ── FOOTER ── */
  footer {
    background: var(--dark);
    border-top: 1px solid rgba(201,149,42,0.15);
    padding: 3rem 4rem;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 1.5rem;
  }
  .footer-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.12em;
    color: var(--cream);
  }
  .footer-copy { font-size: 0.78rem; color: var(--muted); }
  .footer-links { display: flex; gap: 1.5rem; }
  .footer-links a { font-size: 0.78rem; color: var(--muted); text-decoration: none; transition: color 0.2s; }
  .footer-links a:hover { color: var(--gold); }

  /* ── SCROLL ANIMATION ── */
  .fade-up { opacity: 0; transform: translateY(24px); transition: opacity 0.6s, transform 0.6s; }
  .fade-up.visible { opacity: 1; transform: none; }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    nav { padding: 1rem 1.5rem; }
    .nav-links { display: none; }
    section { padding: 4rem 1.5rem; }
    #hero { padding: 0; }
    .hero-content { padding: 0 1.5rem; }
    .hero-badge { left: 1.5rem; }
    #about { grid-template-columns: 1fr; gap: 3rem; }
    #visit { grid-template-columns: 1fr; gap: 2rem; }
    footer { flex-direction: column; align-items: flex-start; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="logo">
    <span class="logo-scissors">✂</span> TRIMS.
  </div>
  <ul class="nav-links">
    <li><a href="#services">Services</a></li>
    <li><a href="#about">About</a></li>
    <li><a href="#reviews">Reviews</a></li>
    <li><a href="#visit">Visit</a></li>
  </ul>
  <a href="#booking" class="nav-book">📞 Book Now</a>
</nav>

<!-- HERO -->
<section id="home">
  <div class="hero-bg"></div>
