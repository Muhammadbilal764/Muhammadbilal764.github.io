      <div class="service-price">Rs. 400 <span>/ session</span></div>
    </div>
    <div class="service-card">
      <span class="service-icon">🧴</span>
      <h3 class="service-name">Hair Treatment</h3>
      <p class="service-desc">Deep conditioning and scalp treatment for healthy, strong hair growth.</p>
      <div class="service-price">Rs. 1,200 <span>/ session</span></div>
    </div>
    <div class="service-card">
      <span class="service-icon">👑</span>
      <h3 class="service-name">Groom Package</h3>
      <p class="service-desc">Complete grooming experience — cut, shave, facial, and styling in one session.</p>
      <div class="service-price">Rs. 2,000 <span>/ session</span></div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about">
  <div class="about-image-wrap fade-up">
    <img src="https://images.unsplash.com/photo-1621605815971-fbc98d665033?w=800&q=80" alt="Trims studio interior" loading="lazy">
    <div class="about-accent"></div>
